#!/bin/sh
# 커밋 전 훅: 폴더 색인을 다시 만들어 바뀐 색인 파일을 스테이지에 더한다.
# 머지 커밋 전 훅(pre-merge-commit)은 이 파일을 인자 merge로 부른다. 머지 모드는 스테이지를
# 바꾸지 않고, 바뀔 색인이 있으면 머지 커밋을 멈춘다.
# 현재 브랜치가 main인 머지 커밋(자동 머지와 충돌 해소 커밋)에서만 형식 감사를 돌리고,
# 통과하면 루트 AGENTS/main-merge-checks/의 main 머지 검사를 이름 순으로 돌린다.
# 연결: git config core.hooksPath <이 hooks 폴더의 루트 상대 경로>
# Python 3.9 이상을 찾지 못하거나, 생성기가 실패하거나, 감사나 main 머지 검사가 0이 아닌
# 값으로 끝나면 막는다. 감사가 통과하면 요약 줄만 내고, 경고가 있으면 상세를 보는 명령을 덧붙인다.

mode=${1:-commit}
if [ "$mode" = merge ]; then
    hook=pre-merge-commit
else
    hook=pre-commit
fi

root=$(git rev-parse --show-toplevel) || exit 1

# main 머지 판정. 자동 머지의 머지 커밋 전 훅 시점에는 MERGE_HEAD가 아직 없어 머지 모드로
# 판정하고, 커밋 전 훅은 MERGE_HEAD로 충돌 해소 커밋을 가린다. 워크트리에서는 .git이 파일이라
# MERGE_HEAD를 경로로 보지 않는다.
main_merge=
if [ "$(git symbolic-ref -q HEAD)" = refs/heads/main ]; then
    if [ "$mode" = merge ] || git rev-parse -q --verify MERGE_HEAD >/dev/null; then
        main_merge=1
    fi
fi
abort_hint="git merge --abort로 머지를 거두고 작업 브랜치에서 고친 뒤 다시 머지한다."

# 도구는 저장소 루트가 아니라 이 훅 파일 위치 기준으로 찾는다.
tools=$(dirname "$(dirname "$0")")
gen="$tools/build_index.py"
aud="$tools/audit.py"
for f in "$gen" "$aud"; do
    if [ ! -f "$f" ]; then
        echo "$hook: tool not found. 도구가 없다 - $f" >&2
        exit 1
    fi
done

# python3, python, py -3 순으로 3.9 이상인 것을 고른다. py -3은 단어 분할로 나뉜다.
py=
for c in python3 python "py -3"; do
    if $c -c 'import sys; sys.exit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
        py=$c
        break
    fi
done
if [ -z "$py" ]; then
    echo "$hook: Python 3.9 not found. Python 3.9 이상을 찾지 못했다." >&2
    exit 1
fi

# 막힌 커밋의 다시 만든 색인을 알린다. git commit -a와 경로를 지정한 커밋은 막히면
# 훅이 더한 스테이지를 버리고, 다음 시도의 생성기는 이미 반영된 경로를 내지 않는다.
# 스테이지 대상과 같게, 추적되지 않던 남는 쪽을 지운 경로는 뺀다.
restage_hint() {
    [ -n "$out" ] || return 0
    echo "$hook: 다시 만든 색인. 스테이지에 없으면 git add로 올리고 경로를 지정하지 않은 git commit으로 다시 커밋한다:" >&2
    cr=$(printf '\r')
    printf '%s\n' "$out" | while IFS= read -r p; do
        p=${p%"$cr"}
        [ -n "$p" ] || continue
        if [ -e "$root/$p" ] || git --literal-pathspecs -C "$root" ls-files --error-unmatch -- "$p" >/dev/null 2>&1; then
            printf '%s\n' "$p" >&2
        fi
    done
}

if [ "$mode" = merge ]; then
    # 이 훅이 스테이지에 더한 파일은 머지 커밋에 들어가지 않으므로 바뀔 경로만 본다.
    out=$($py -B "$gen" "$root" --dry-run)
    status=$?
    if [ "$status" -ne 0 ]; then
        echo "$hook: index check failed. 색인 확인이 실패해 머지 커밋을 멈춘다. 원인을 고친 뒤 git commit으로 머지를 마친다." >&2
        exit "$status"
    fi
    if [ -n "$out" ]; then
        printf '%s\n' "$out" >&2
        if [ -n "$main_merge" ]; then
            then_do="다시 만들고 감사한다"
        else
            then_do="다시 만든다"
        fi
        echo "$hook: index out of date. 머지 결과와 색인이 달라 머지 커밋을 멈춘다. git commit으로 머지를 마치면 커밋 전 훅이 색인을 ${then_do}." >&2
        exit 1
    fi
else
    out=$($py -B "$gen" "$root")
    status=$?
    if [ "$status" -ne 0 ]; then
        echo "$hook: index build failed. 색인 생성이 실패해 커밋을 막는다." >&2
        exit "$status"
    fi

    # 바뀐 경로를 스테이지에 더한다. 추적되지 않던 남는 쪽을 지운 경우는 건너뛴다.
    # --literal-pathspecs는 ":"로 시작하는 이름이 pathspec 매직으로 읽히지 않게 한다.
    cr=$(printf '\r')
    printf '%s\n' "$out" | while IFS= read -r p; do
        p=${p%"$cr"}
        [ -n "$p" ] || continue
        if [ -e "$root/$p" ] || git --literal-pathspecs -C "$root" ls-files --error-unmatch -- "$p" >/dev/null 2>&1; then
            git --literal-pathspecs -C "$root" add -A -- "$p" || exit 1
        fi
    done || {
        restage_hint
        exit 1
    }
fi

[ -n "$main_merge" ] || exit 0

# 감사는 스테이지가 아니라 작업 트리를 본다.
res=$($py -B "$aud" "$root" 2>&1)
status=$?
summary=$(printf '%s\n' "$res" | sed -n '$p')
if [ "$status" -ne 0 ]; then
    printf '%s\n' "$res" >&2
    # 감사가 끝까지 돌아 요약 줄을 낸 종료 코드 1만 위반이다. 진입 파일의 구문 오류
    # 같은 실행 실패도 Python이 1로 끝내므로 요약 줄로 구별한다.
    if [ "$status" -eq 1 ] && printf '%s\n' "$summary" | LC_ALL=C grep -qE '^감사 완료: 위반 [0-9]+건'; then
        echo "$hook: audit violations. 형식 감사 위반이 있어 main 머지 커밋을 막는다. $abort_hint" >&2
    else
        echo "$hook: audit failed. 형식 감사가 종료 코드 ${status}로 끝나 main 머지 커밋을 막는다. $abort_hint" >&2
    fi
    exit 1
fi
printf '%s: %s\n' "$hook" "$summary" >&2
# 감사 출력은 UTF-8이다. 로캘과 무관하게 바이트로 비교한다.
if ! printf '%s\n' "$summary" | LC_ALL=C grep -qE '^감사 완료: 위반 [0-9]+건, 경고 0건 \('; then
    # 어느 폴더에서 실행해도 같은 대상을 보도록 절대 경로로 내고, 작은따옴표를
    # 닫고 인용한 뒤 다시 열어 경로마다 한 인자로 표시한다.
    case $aud in
        /*|[A-Za-z]:*) aud_abs=$aud ;;
        *) aud_abs="$root/$aud" ;;
    esac
    q_aud=$(printf '%s\n' "$aud_abs" | LC_ALL=C sed "s/'/'\\\\''/g")
    q_root=$(printf '%s\n' "$root" | LC_ALL=C sed "s/'/'\\\\''/g")
    printf "%s: 경고 상세는 %s -B '%s' '%s' 로 본다.\n" "$hook" "$py" "$q_aud" "$q_root" >&2
fi

# main 머지 검사: 이름 순(LC_ALL=C)으로 돌리고, _와 .으로 시작하는 파일은 건너뛴다.
[ -d "$root/AGENTS/main-merge-checks" ] || exit 0
lc_set=${LC_ALL+x}
lc_old=${LC_ALL-}
LC_ALL=C
set -- "$root/AGENTS/main-merge-checks"/*.py
if [ -n "$lc_set" ]; then LC_ALL=$lc_old; else unset LC_ALL; fi
for f in "$@"; do
    [ -f "$f" ] || continue
    name=${f##*/}
    case $name in _*) continue ;; esac
    # git이 훅에 넘긴 GIT_ 변수(GIT_INDEX_FILE, GIT_DIR 등)를 지운다. 검사가 임시 레포에서
    # git을 돌릴 때 이 레포의 색인을 건드리지 않게 한다. 이름 패턴으로 좁혀 unset에 넘긴다.
    res=$(cd "$root" &&
        unset $(env | LC_ALL=C sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p') &&
        $py -B "$f" "$root" </dev/null 2>&1)
    status=$?
    if [ "$status" -ne 0 ]; then
        printf '%s\n' "$res" >&2
        echo "$hook: main merge check failed. main 머지 검사 ${name}이 종료 코드 ${status}로 끝나 main 머지 커밋을 막는다. $abort_hint" >&2
        exit 1
    fi
    echo "$hook: main merge check ${name} 통과" >&2
done
exit 0
